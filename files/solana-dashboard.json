          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "slot",
            "axisPlacement": "auto",
            "axisCenteredZero": true
          }
        },
        "overrides": []
